# Snatcher environment — copy to .env for local runs.
# On Koyeb, set these in the service dashboard instead.
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
# Pretty, colourised logs (pino-pretty). Set to 0 for raw JSON.
LOG_PRETTY=1
# Path to the yt-dlp binary. Defaults to `yt-dlp` on PATH.
YTDLP_PATH=yt-dlp
# YouTube login cookies, to pass YouTube's "sign in to confirm you're not a
# bot" check on datacenter IPs. YTDLP_COOKIES holds the Netscape cookies.txt
# CONTENT — set it in Koyeb as a secret env var, never commit the real value.
# YTDLP_COOKIES_FILE is a path to a cookies.txt file instead (local runs).
# Only youtube.com cookies are needed. Leave both unset to run without.
YTDLP_COOKIES=
YTDLP_COOKIES_FILE=
# Pinterest login cookies, for the pin-page scrape. Pinterest serves a
# datacenter IP a pin page without the video; a logged-in session gets the
# full page (with the progressive MP4). PINTEREST_COOKIES holds the raw
# Cookie header value — set it in Koyeb as a secret env var, never commit
# the real value. Leave unset to run the scrape anonymously, as before.
PINTEREST_COOKIES=
# Secret for signing /dl URLs. Leave unset for a random per-boot secret
# (note: restarts invalidate old download links).
DOWNLOAD_SECRET=
# Resolve cache: 10 minutes, 500 entries.
CACHE_TTL_MS=600000
CACHE_MAX=500
# Upstream timeouts (ms).
UPSTREAM_TIMEOUT_MS=30000
YTDLP_TIMEOUT_MS=60000
# Downloads get their own, longer cap: a big merge can take minutes, and a
# 60s kill turns a slow-but-working download into a 504. 10 minutes.
YTDLP_DOWNLOAD_TIMEOUT_MS=600000
# Rate limit: 60 requests per IP per minute.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
# Upstream concurrency + batch size.
QUEUE_CONCURRENCY=3
BATCH_MAX_URLS=10
# Largest single download the proxy will stream (bytes). 2 GB default.
MAX_DOWNLOAD_BYTES=2147483648
