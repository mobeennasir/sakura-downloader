<%- include('partials/head', { title: page.title + ' · Snatcher', description: page.line }) %>
<body data-page="error">
<%- include('partials/icons') %>
<%- include('partials/header', { platforms }) %>
<main>
  <div class="container">
    <div class="error-page">
      <p class="error-code"><%= page.status %> · <%= code %></p>

      <div class="error-animation anim-<%= page.animation %>" aria-hidden="true">
        <% if (page.animation === 'space') { %>
          <svg viewBox="0 0 148 148" fill="none" stroke="currentColor" stroke-width="2">
            <circle class="star" cx="22" cy="30" r="2.5" fill="currentColor" stroke="none" />
            <circle class="star" cx="122" cy="24" r="2" fill="currentColor" stroke="none" />
            <circle class="star" cx="104" cy="122" r="2.5" fill="currentColor" stroke="none" />
            <g class="planet">
              <circle cx="74" cy="74" r="32" />
              <ellipse cx="74" cy="74" rx="50" ry="13" transform="rotate(-20 74 74)" />
            </g>
          </svg>
        <% } else if (page.animation === 'broken-link') { %>
          <svg viewBox="0 0 148 148" fill="none" stroke="currentColor" stroke-width="2">
            <rect class="link-half-left" x="20" y="58" width="46" height="32" rx="16" />
            <rect class="link-half-right" x="82" y="58" width="46" height="32" rx="16" />
            <path d="M74 58v32" stroke-dasharray="3 6" />
          </svg>
        <% } else if (page.animation === 'lock') { %>
          <svg viewBox="0 0 148 148" fill="none" stroke="currentColor" stroke-width="2">
            <path class="shackle" d="M56 68V52a18 18 0 0 1 36 0v16" />
            <rect x="44" y="68" width="60" height="52" rx="4" />
            <circle cx="74" cy="90" r="5" fill="currentColor" stroke="none" />
            <path d="M74 95v10" />
          </svg>
        <% } else if (page.animation === 'meter') { %>
          <svg viewBox="0 0 148 148" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="20" y="66" width="108" height="14" />
            <rect class="meter-fill" x="20" y="66" width="108" height="14" fill="currentColor" stroke="none" />
          </svg>
        <% } else if (page.animation === 'hourglass') { %>
          <svg class="anim-hourglass" viewBox="0 0 148 148" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M52 28h44L74 70 52 28z" />
            <path d="M52 120h44L74 78 52 120z" />
            <path d="M44 28h60M44 120h60" />
          </svg>
        <% } else if (page.animation === 'crack') { %>
          <svg viewBox="0 0 148 148" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="34" y="34" width="80" height="80" />
            <path class="crack-line" d="M74 34 66 58l14 16-12 22 8 18" />
          </svg>
        <% } else { %>
          <svg viewBox="0 0 148 148" fill="none" stroke="currentColor" stroke-width="2">
            <rect class="empty-square" x="44" y="44" width="60" height="60" />
          </svg>
        <% } %>
      </div>

      <h1><%= page.title %></h1>
      <p class="lede"><%= page.line %></p>

      <div class="error-actions">
        <button type="button" class="btn btn--primary" onclick="history.back()">Try again</button>
        <a class="btn btn--secondary" href="/">Back home</a>
      </div>
    </div>
  </div>
</main>
<%- include('partials/footer') %>
