<footer class="site-footer">
  <div class="container">
    <a class="wordmark" href="/">
      <svg aria-hidden="true"><use href="#i-logo" /></svg>
      Snatcher
    </a>
    <p>Paste a link. Take the file. Six platforms, one bar.</p>
